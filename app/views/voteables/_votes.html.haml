- if voteable.rollcall?
  .view-content.-tight
    .wrapper{role: 'layout'}
      .cols{role: 'layout'}
        - %w(for against abstain).each do |status|
          - votes = voteable.votes.includes(:councillor).by_councillor_name.where(status: status)
          
          .col
            %nav.view-subnav.-two
              .subnav-heading
                .vote-status-heading
                  .text
                    .status= status.capitalize
                    .count= pluralize votes.count, 'councillor'
                  = render partial: 'votes/vote-visualiser', locals: {votes: votes}

            %ul.list.-enumerable
              - votes.each do |vote|
                %li
                  = link_to vote.councillor do
            - councillor = vote.councillor
            - party = councillor.party
                    .enumerable.-councillor
              .indicator.party-indicator{title: (party.present? ? party.name : councillor.full_name)}
                = render partial: 'icons/party', locals: {party: party}
                      .content
                .name= councillor.full_name

- else
  .view-content.-omega
    .wrapper{role: 'layout'}
      .voice-vote.empty-explanation
        %div
          %label Voice vote
          %p This motion #{ voteable.result }ed by a voice vote, so we don't have a breakdown of how each councillor voted.